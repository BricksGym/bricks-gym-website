# Copy these into Vercel → Project → Settings → Environment Variables.
# Never put real values in this file or share them.

# Email (resend.com) — sends applications, contact messages and cancellations
RESEND_API_KEY=
EMAIL_FROM="Bricks Gym <hello@yourdomain.com>"

# Cloudflare Turnstile spam protection (dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Plausible analytics (optional) — your domain as registered in Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
